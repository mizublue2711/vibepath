# ==========================================
# VIBEPATH WEB CLIENT - ENVIRONMENT VARIABLES (.env.example)
# ==========================================

# 1. Mapbox Public Access Token (Required for 3D Globe WebGL)
# Lấy Token của bạn tại: [suspicious link removed]
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# 2. Cloudflare Worker Backend Proxy URL (Optional / Production)
VITE_API_PROXY_URL=[suspicious link removed]

# 3. Cloud Automation Webhook URL (Optional / Production)
VITE_N8N_WEBHOOK_URL=[suspicious link removed]

# 4. Application Environment Mode
VITE_APP_ENV=development
